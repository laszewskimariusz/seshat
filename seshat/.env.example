# ── Required ──────────────────────────────────────────────

# JWT signing secret — generate with: openssl rand -base64 32
# CHANGE THIS before running in production!
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# Database URL
# SQLite (default — zero config):
DATABASE_URL="file:./data/seshat.db"

# PostgreSQL (optional — see docs/DATABASE.md):
# DATABASE_URL="postgresql://user:password@localhost:5432/seshat"

# MySQL (optional — see docs/DATABASE.md):
# DATABASE_URL="mysql://user:password@localhost:3306/seshat"

# ── Optional ───────────────────────────────────────────────

# Port the app listens on (default: 3000)
PORT=3000

# Environment
NODE_ENV=production

# Public URL (used for SSE reconnect hints)
NEXT_PUBLIC_APP_URL=http://localhost:3000
